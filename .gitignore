# Python - compilatión y caché
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales (venv, conda, etc.)
venv/
.venv/
env/
.env

# Configuración del IDE
.vscode/
.idea/

# Datos del proyecto y resultados (evitar subir vídeos y salidas pesadas)
data/outputs/*
!data/outputs/.gitkeep
data/inputs/videos/*
!data/inputs/videos/.gitkeep

# Modelos pesados (Los archivos .pt suelen ser grandes para GitHub normal)
# Si tu modelo pesa menos de 50MB o lo necesitas en el repo, puedes comentar esta línea
models/*.pt
